---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Mesocycle Planner</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		color-scheme: light;
		--bg-page: #f8fafc;
		--bg-panel: #ffffff;
		--bg-subtle: #f1f5f9;
		--bg-input: #f8fafc;
		--bg-glass: rgba(255, 255, 255, 0.7);
		--text-primary: #0f172a;
		--text-secondary: #64748b;
		--text-tertiary: #94a3b8;
		--border: #e2e8f0;
		--border-strong: #cbd5e1;
		--border-focus: #6366f1;
		--accent: #6366f1;
		--accent-hover: #4f46e5;
		--accent-light: #eef2ff;
		--accent-glow: rgba(99, 102, 241, 0.15);
		--strength: #10b981;
		--strength-bg: #ecfdf5;
		--endurance: #0ea5e9;
		--endurance-bg: #f0f9ff;
		--mixed: #8b5cf6;
		--mixed-bg: #f5f3ff;
		--deload: #f59e0b;
		--deload-bg: #fffbeb;
		--rest: #94a3b8;
		--rest-bg: #f8fafc;
		--shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.04), 0 1px 3px rgba(0, 0, 0, 0.02);
		--shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 10px 15px -3px rgba(0, 0, 0, 0.05);
		--shadow-lg: 0 10px 25px -5px rgba(0, 0, 0, 0.06), 0 20px 40px -10px rgba(0, 0, 0, 0.08);
		--shadow-xl: 0 20px 50px -12px rgba(0, 0, 0, 0.12);
		--radius-sm: 8px;
		--radius-md: 12px;
		--radius-lg: 16px;
		--radius-xl: 20px;
		--transition-fast: 0.15s cubic-bezier(0.4, 0, 0.2, 1);
		--transition-smooth: 0.25s cubic-bezier(0.4, 0, 0.2, 1);
	}

	:root[data-theme='dark'] {
		color-scheme: dark;
		--bg-page: #0c1222;
		--bg-panel: #151e30;
		--bg-subtle: #1e293b;
		--bg-input: #1e293b;
		--bg-glass: rgba(21, 30, 48, 0.8);
		--text-primary: #f1f5f9;
		--text-secondary: #94a3b8;
		--text-tertiary: #64748b;
		--border: #1e293b;
		--border-strong: #334155;
		--accent-light: rgba(99, 102, 241, 0.15);
		--accent-glow: rgba(99, 102, 241, 0.25);
		--strength-bg: rgba(16, 185, 129, 0.12);
		--endurance-bg: rgba(14, 165, 233, 0.12);
		--mixed-bg: rgba(139, 92, 246, 0.12);
		--deload-bg: rgba(245, 158, 11, 0.12);
		--rest-bg: #1e293b;
		--shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.2);
		--shadow-md: 0 4px 12px rgba(0, 0, 0, 0.25);
		--shadow-lg: 0 10px 30px rgba(0, 0, 0, 0.35);
		--shadow-xl: 0 20px 50px rgba(0, 0, 0, 0.5);
	}

	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
		background: var(--bg-page);
		color: var(--text-primary);
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
		line-height: 1.5;
	}

	a {
		color: var(--accent);
		text-decoration: none;
	}

	a:hover {
		text-decoration: underline;
	}
</style>
